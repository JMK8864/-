classDiagram
  direction TB
  class TcpServerServiceBase~TConfig~ {
    #FillPipeAsync()
    #ReadPipeAsync()
  }
  class TcpServerFinalService {
    -ListenOnPortAsync()
    -HandleClientSessionAsync()
    -CheckClientTimeoutsAsync()
    -ProcessTcpCommandAsync()
  }
  class ITcpMessageHandler {
    <<interface>>
    +Priority
    +CanHandle()
    +HandleAsync()
  }
  class JsonMessagedHandler
  class TcpServerConnectionManager {
    +AddClient() RemoveClient()
    +AddOrUpdateClientNickname()
    +SendToClientAsync()
  }
  class LogisticsSystemStateManager {
    +GetResponseHeartbeatMessageAsync()
    +AccumProcessCountFromClientAsync()
    +GetAllStatusAsync()
    +GetProcessCountsAsync()
  }
  class EventDataStoreService {
    +GetAsync() UpdateAsync()
    +RestoreAsync()
    -FlushAsync() DeleteOldEventsAsync()
  }
  class DataCollectorService {
    -ProcessAggregationBufferAsync()
    -UpsertBulkCollectedPayloadToRawCountDb()
    -CallAggregationDbProcedureContinuouslyAsync()
  }
  class DeviceStatusManager {
    +ProcessHeartbeatMessageAsync()
  }
  class DockController
  class SettingsController
  class ProcessCountController

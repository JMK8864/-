# ===== FTMS 로컬 실행 환경 (docker compose) =====
# PostgreSQL 관리자(postgres) 비밀번호
POSTGRES_PASSWORD=ChangeMe_Admin!1
# 앱 계정(tapsuser) 비밀번호 → app-server appsettings.json 연결 문자열 2곳에 동일하게 입력
FTMS_DB_PASSWORD=ChangeMe_App!1

# Windows 에서 접속할 DB 포트 (Windows 에 PostgreSQL 이 이미 있으면 5433 등으로 변경)
FTMS_DB_PORT=5432

# 브라우저 접속 포트 (http://localhost:80). 80 이 사용 중이면 8080 등으로 변경
FTMS_HTTP_PORT=80

# nginx → Windows 에서 실행 중인 app-server / DxfBlazorViewer
FTMS_API_UPSTREAM=host.docker.internal:8121
FTMS_WEB_UPSTREAM=host.docker.internal:8122

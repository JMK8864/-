# ===== FTMS 로컬 실행 환경 (WSL Docker Engine) =====
# PostgreSQL 관리자(postgres) 비밀번호
POSTGRES_PASSWORD=ChangeMe_Admin!1
# 앱 계정(tapsuser) 비밀번호 → app-server appsettings.json 연결 문자열 2곳에 동일하게 입력
FTMS_DB_PASSWORD=ChangeMe_App!1

# Windows 에서 접속할 DB 포트 (Windows 에 PostgreSQL 이 이미 있으면 5433 등으로 변경)
FTMS_DB_PORT=5432
# 브라우저 접속 포트 (http://localhost). 80 사용 중이면 8080 등
FTMS_HTTP_PORT=80

# nginx 컨테이너 → Windows(VS) 에서 실행 중인 app-server / DxfBlazorViewer
#   auto : start.sh 가 WSL 기본 게이트웨이(= Windows 호스트 IP)를 매번 자동 감지 (WSL 재시작 시 IP 바뀜)
#   직접 지정 예: FTMS_WIN_HOST=172.28.80.1  또는 다른 PC 의 IP
FTMS_WIN_HOST=auto
FTMS_API_PORT=8121
FTMS_WEB_PORT=8122

# ↓ start.sh 가 자동으로 기록하는 값 (직접 수정하지 마세요)
FTMS_WIN_HOST_RESOLVED=

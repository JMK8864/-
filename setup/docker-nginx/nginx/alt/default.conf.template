# =============================================================================
# [선택] web-server.ftms 없이 nginx 가 Blazor WASM 파일을 직접 제공하는 구성
#   사용법: docker-compose.yml 에서
#     - ./nginx/templates  대신  ./nginx/alt  를 /etc/nginx/templates 에 마운트
#     - ./wwwroot:/usr/share/nginx/ftms:ro  볼륨 주석 해제
#   wwwroot = dotnet publish DxfBlazorViewer.Client.csproj -c Release -o out  →  out/wwwroot
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ftms_api {
    server ${FTMS_API_UPSTREAM};
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 500m;
    proxy_http_version 1.1;
    server_tokens off;

    access_log /var/log/nginx/ftms_access.log;
    error_log  /var/log/nginx/ftms_error.log warn;

    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }

    location = /health {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Connection "";
        proxy_pass http://ftms_api;
    }

    location /chathub {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering    off;
        proxy_pass http://ftms_api;
    }

    location /api/ {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_pass http://ftms_api;
    }

    # ---- Blazor WASM 정적 파일 ----
    root /usr/share/nginx/ftms;
    index index.html;
    gzip_static on;                          # publish 가 만든 *.gz 사용

    # wasm 및 Blazor 리소스 MIME (기본 mime.types 에 없는 것 보충)
    location ~* \.(dll|dat|blat|pdb)$ {
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=31536000";
        try_files $uri =404;
    }
    location ~* \.wasm$ {
        types { application/wasm wasm; }
        add_header Cache-Control "public, max-age=31536000";
        try_files $uri =404;
    }
    # 버전 정보 파일은 캐시하지 않음 (배포 후 바로 반영)
    location ~* (index\.html|blazor\.boot\.json|service-worker.*\.js)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # SPA 라우팅: /viewer, /alarms 등 → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}

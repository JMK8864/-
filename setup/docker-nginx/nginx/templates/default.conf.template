# =============================================================================
# FTMS reverse proxy (nginx in Docker)
#   공식 nginx 이미지가 기동 시 ${FTMS_API_UPSTREAM} 등 환경변수를 치환하여
#   /etc/nginx/conf.d/default.conf 로 생성(이미지 기본 설정 대체)합니다. (값은 .env 에서 설정)
#
#   /health, /chathub(SignalR), /api/*  -> app-server.ftms  (${FTMS_API_UPSTREAM})
#   그 외                                -> web-server.ftms  (${FTMS_WEB_UPSTREAM})
#
#   주의: location 안에 proxy_set_header 가 하나라도 있으면 바깥 설정이 상속되지 않으므로
#        공통 헤더는 include 파일(ftms_proxy_headers)로 각 location 에 넣습니다.
# =============================================================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ftms_api {
    server ${FTMS_API_UPSTREAM};
    keepalive 32;
}

upstream ftms_web {
    server ${FTMS_WEB_UPSTREAM};
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 500m;      # reverse-proxy.ftms(YARP) 와 동일
    proxy_http_version 1.1;
    server_tokens off;

    access_log /var/log/nginx/ftms_access.log;
    error_log  /var/log/nginx/ftms_error.log warn;

    # 0. nginx 자체 상태 확인 (docker healthcheck 용)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 1. app-server 상태
    location = /health {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Connection "";
        proxy_pass http://ftms_api;
    }

    # 2. SignalR (WebSocket 업그레이드 필수)
    location /chathub {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering    off;
        proxy_pass http://ftms_api;
    }

    # 3. REST API
    location /api/ {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;    # RawData 다운로드 등
        proxy_pass http://ftms_api;
    }

    # 4. 나머지 → Blazor WASM 정적 파일 서버(web-server.ftms)
    location / {
        include /etc/nginx/ftms_proxy_headers;
        proxy_set_header Connection "";
        proxy_pass http://ftms_web;
    }
}
